api.txt
.env.backup*

# SHARE hand-off artefacts — regenerated from the live stack, never committed.
# .env and certs/*.key under SHARE/ are already covered by the rules above.
# The whole directory is ignored rather than just its dumps: it is a 217 MB
# rebuildable hand-off bundle (certs, a database dump, a schema snapshot and
# a frontend env file), and none of it is source.
SHARE/
SHARE_muhafiz_*.zip

# Local-only compose override. Its own header says it exists so THIS
# checkout points at a project-local pgdata volume instead of the
# team-shared one — committing it would repoint everyone else's stack.
docker-compose.override.yml

# QA review bundle, extracted and zipped. Working material, not source.
qa review.zip
