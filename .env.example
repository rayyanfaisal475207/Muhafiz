# ============================================================
# Muhafiz — Environment Variables Template
# Copy this to .env and fill in your real API keys
# NEVER commit .env to version control
# ============================================================

# ----- LLM Provider (text generation) -----
# "groq" = LLaMA 3.3 70B via Groq (fast, recommended)
# "gemini" = Google Gemini 2.0 Flash
# "openai" = OpenAI GPT-4o
# "anthropic" = Anthropic Claude
LLM_PROVIDER=groq

# Groq (https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_key_here
# Groq retires/renames models over time (llama-3.3-70b-versatile, this
# value until it was found 404ing in production, is already gone) --
# check https://console.groq.com/docs/models before deploying.
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# OpenAI (optional)
# OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_MODEL=gpt-4o
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic (optional)
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ----- Embedding Provider -----
# Default architecture is the locally-served multilingual-e5-large-instruct
# model ("e5"). Groq has no embedding API — "gemini" or "openai" also work.
EMBEDDING_PROVIDER=e5

# Expected embedding vector dimension for EMBEDDING_PROVIDER above (e5=1024,
# gemini=3072, openai=1536, local=384). Leave unset to use the provider's
# default; only set this if a non-default model changes the output size.
# EXPECTED_EMBEDDING_DIM=1024

# Web Search Integration (Phase 5)
TAVILY_API_KEY=

# ----- PostgreSQL -----
# Local/self-hosted only: docker compose up -d  (see docker-compose.yml)
# The DataGateway connects directly via async SQLAlchemy + asyncpg — no
# REST/hosted fallback path exists in this repo.
# TLS enabled for Phase 9 deployment hardening:
#
# IMPORTANT (issues.md's 13th Critical finding, migrations/015_app_least_privilege_role.sql):
# this must point at a non-superuser, non-BYPASSRLS role, or every RLS
# policy from Phase 2 is silently inert regardless of correctness — a
# Postgres superuser/BYPASSRLS role always bypasses row-level security,
# no matter what FORCE ROW LEVEL SECURITY or the app's own set_config()
# calls do. Apply migration 015, set a real password for muhafiz_app
# (ALTER ROLE muhafiz_app WITH PASSWORD '...'), then point DATABASE_URL at
# it, same pattern as MCP_DATABASE_URL below. Existing .env files pointing
# at the superuser role will NOT auto-update — this must be changed by
# hand in every real deployment. Verify with scripts/verify_app_role.py.
DATABASE_URL=postgresql+asyncpg://muhafiz_app:CHANGE_ME@localhost:5432/muhafiz?ssl=require

# If DATABASE_URL isn't configured, the app refuses to start rather than
# silently falling back to a legacy SQLite schema that predates the entire
# case/auth/RBAC model. Set to "false" only for narrow legacy/local
# debugging where that degraded mode is genuinely what you want.
REQUIRE_POSTGRES=true

# Least-privilege connection string for the MCP Postgres route (SELECT-only
# on police_reference_data — see migrations/009_mcp_readonly_role.sql).
# No fallback: if unset, the MCP Postgres route raises RuntimeError on
# first use (a startup warning also fires so this is caught before that).
# MCP_DATABASE_URL=postgresql://muhafiz_mcp_readonly:CHANGE_ME@localhost:5432/muhafiz

# ----- Aggregate AGE query limits (Phase 5D safe gateway) -----
# The independent AGE route no longer executes model-written Cypher: a model
# emits a typed query PLAN, and trusted code validates and compiles it into
# read-only Cypher run against the production graph. These bound cost, not
# risk — a read-only aggregate can still pin a connection.
# AGE_QUERY_STATEMENT_TIMEOUT_MS=15000
# AGE_QUERY_MAX_ROWS=1000
# AGE_QUERY_MAX_POOL_SIZE=4

# ----- Isolated AGE evaluator — TEST INFRASTRUCTURE ONLY (Phase 5C) -----
# RETAINED for adversarial/security testing, NOT required at runtime. Phase
# 5D removed the production dependency on it; leaving these unset disables
# nothing in the application. Destructive security tests run here so they
# never touch production.
# The independent AGE route runs MODEL-GENERATED Cypher. Apache AGE 1.5.0 has
# no read-only mode — measured: SET, REMOVE and DETACH DELETE all succeed
# under SELECT-only grants AND default_transaction_read_only=on — so that
# Cypher must never touch the production database. It runs instead as a
# dedicated role in a separate, DISPOSABLE database that has no CONNECT
# privilege on `muhafiz`; PostgreSQL refuses at connection time, before any
# Cypher is parsed. Note that where pg_hba grants `trust` (commonly
# 127.0.0.1/::1 in local container setups) the password below is NOT a
# boundary at all — the CONNECT denial is, and it holds either way.
#
# NO FALLBACK BY DESIGN: if unset, the independent AGE route is disabled and
# refuses. It never falls back to DATABASE_URL. The client also refuses any
# URL naming `muhafiz`, or naming anything but `muhafiz_age_eval`.
#
# Provision the database/role, then populate the graph with:
#   python scripts/rebuild_age_eval.py --execute
# AGE_EVAL_DATABASE_URL=postgresql://muhafiz_age_eval_app:CHANGE_ME@localhost:5432/muhafiz_age_eval

# OPERATOR-ONLY connection to the same evaluator database, used by
# scripts/rebuild_age_eval.py and by nothing else. Rebuilding calls
# drop_graph()/create_graph(), which need ownership of the ag_catalog objects
# the AGE extension installed — deliberately NOT granted to the evaluator
# application role above, since that is the role running model-generated
# Cypher and its narrowness is the containment boundary.
# AGE_EVAL_ADMIN_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/muhafiz_age_eval

# Server-side statement_timeout (ms) for generated evaluator queries.
# AGE_EVAL_STATEMENT_TIMEOUT_MS=15000
# Hard cap on rows one evaluator query may return.
# AGE_EVAL_MAX_ROWS=1000
# Bounded evaluator pool, so evaluation cannot exhaust app connection slots.
# AGE_EVAL_MAX_POOL_SIZE=4

# [Module 178] LLM-generated graph queries as the LAST fallback for a
# cross-case question no aggregate answers and no plan composes. OFF by
# default — docs/gold-qa-wave2-results/MODULE178_RESULT.md §6 is the
# measurement that decides. When on, the generated Cypher runs on the
# MCP_DATABASE_URL role above (migration 033 grants it SELECT on the graph),
# inside a READ ONLY transaction that is always rolled back, capped at
# LLM_QUERY_FALLBACK_ROW_CAP rows and LLM_QUERY_FALLBACK_TIMEOUT_S seconds,
# and the served answer shows the query and is marked unverified.
# LLM_QUERY_FALLBACK_ENABLED=false
# LLM_QUERY_FALLBACK_ROW_CAP=200
# LLM_QUERY_FALLBACK_TIMEOUT_S=15

# ----- Which engine answers a cross-case aggregate question -----
#   legacy        xagg.run_aggregate() — the keyword-dispatched engine that
#                 has always served this route. THE DEFAULT: leaving this
#                 unset behaves exactly as before the new engine existed.
#   aggregate_v1  src/pipeline/aggregate — NL to a typed AggregateSpec,
#                 deterministic validation, verification policy, then
#                 structured/AGE/semantic routes and reconciliation.
#
# NOT DEFAULTED ON, DELIBERATELY. The two engines disagree by design: the new
# one REFUSES questions the legacy one answers — compound questions, filters
# it cannot express, traversals past its hop limit — because answering them
# meant silently answering a different question. That is the correct
# behaviour and it is also a visible product change, so it is enabled by a
# deliberate flip rather than inherited. Reverting is a restart, not a
# deploy.
# AGGREGATE_ENGINE_MODE=legacy

# Comma-separated list of allowed frontend origins (no spaces around commas).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5174

# ----- Rate-limiter proxy awareness (audit finding F-09) -----
# The login/case-create rate limiter keys on the request's TCP peer address
# by default. Behind any reverse proxy or load balancer, that address is the
# proxy's own IP for every request -- every real client shares one bucket,
# so one user can exhaust the limit for everyone else.
#
# Leave this false (the default) unless this deployment actually sits behind
# a reverse proxy you control. Turning it on WITHOUT also listing every
# trusted proxy's own IP in TRUSTED_PROXY_IPS lets any direct client forge
# X-Forwarded-For and evade rate limiting entirely -- the forwarded header
# is only trusted when the immediate TCP peer is itself in that list.
TRUST_PROXY_HEADERS=false
# TRUSTED_PROXY_IPS=10.0.0.1,10.0.0.2

# ----- Optional local LLM (OpenAI-compatible endpoint) -----
# Reasoning slot (Qwen) — used for routing/rewriting/evaluation/etc.
# Only used when a user's Settings > AI Model Mode is "local".
# Leave LOCAL_LLM_URL empty to disable entirely.
# Updated to use HTTPS for Phase 9:
LOCAL_LLM_URL=https://localhost:8000/v1
LOCAL_LLM_MODEL=qwen3.5-2b
LOCAL_LLM_API_KEY=
LOCAL_LLM_TIMEOUT=20

# Generation slot — used only for the final user-facing answer. Leave
# LOCAL_GEN_LLM_URL empty to disable (falls back to the cloud provider).
LOCAL_GEN_LLM_URL=
LOCAL_GEN_LLM_MODEL=
LOCAL_GEN_LLM_API_KEY=
LOCAL_GEN_LLM_TIMEOUT=20

# Base URL shared by LOCAL_LLM_URL/LOCAL_GEN_LLM_URL/EMBEDDINGS_URL/
# RERANKER_URL when they all live behind one tunnel/model server. Leave
# empty to fall back to LOCAL_LLM_URL.
MODEL_SERVER_BASE_URL=

# Local e5 embeddings + reranker (served via the same model server as
# LOCAL_LLM_URL / LOCAL_GEN_LLM_URL). Only used when EMBEDDING_PROVIDER=e5.
EMBEDDINGS_URL=
RERANKER_URL=

# ----- ChromaDB -----
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=muhafiz_kb

# ----- Muhafiz Data API (docs/decisions/0001-muhafiz-api-migration.md) -----
# A same-schema stand-in for the real police system, serving real-schema
# PSRMS/CMS/PKM/criminal-record data over REST (see API_CONSUMER_GUIDE.md).
# Leave both empty to disable this source entirely — set together, not
# independently (see src/config.py's validate_config()).
MUHAFIZ_API_BASE_URL=
MUHAFIZ_API_KEY=
MUHAFIZ_API_TIMEOUT=60
MUHAFIZ_API_PAGE_SIZE=100

# ----- Pipeline Settings -----
MAX_RETRIES=2
TOP_K_RETRIEVAL=10
TOP_K_RERANK=5
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ----- Guarded web search -----
# Air-gap deployments disable ALL outbound web access (the WEB route and any
# cloud LLM fallback). Requires LOCAL_LLM_URL to be set — with AIR_GAP_MODE
# on and no local endpoint configured, every LLM call fails outright.
AIR_GAP_MODE=false

# Comma-separated allow-list for the WEB route — restricts results to
# government/legal/established-news domains, never the open web.
WEB_ALLOWED_DOMAINS=gov.pk,islamabadpolice.gov.pk,nadra.gov.pk,pakistantoday.com.pk,dawn.com,tribune.com.pk,thenews.com.pk,geo.tv,app.com.pk

# ----- Conversation Memory -----
# Persisted via PostgreSQL (sessions/messages tables), no separate config needed.
MAX_HISTORY_TOKENS=2000

# ----- FastAPI Server -----
HOST=0.0.0.0
PORT=8000
RELOAD=true
# One of: development | staging | production. Gates the cookie Secure flag
# and (per Module 0.2) whether the app refuses to start on a critical
# configuration error. Must be set explicitly and exactly — an unrecognized
# value is treated as a critical startup error.
ENVIRONMENT=development

# ----- Document Ingestion -----
DOCUMENTS_DIR=./data/documents
MAX_UPLOAD_SIZE_MB=50

# ----- Relational Database (legacy SQLite pipeline logging) -----
# Only used in the legacy SQLite fallback (REQUIRE_POSTGRES=false).
DB_PATH=./data/pipeline_logs.db

# ----- Auth -----
# The single most security-critical secret in the app — used to sign/verify
# every JWT. Generate a real random value (e.g. `openssl rand -hex 32`); the
# default below is public (it is in this file) and must never be used
# outside local development.
JWT_SECRET_KEY=your-secret-key-for-dev

