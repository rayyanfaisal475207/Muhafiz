# ============================================================
# Muhafiz — Environment Variables Template
# Copy this to .env and fill in your real API keys
# NEVER commit .env to version control
# ============================================================

# ----- LLM Provider (text generation) -----
# "groq" = LLaMA 3.3 70B via Groq (fast, recommended)
# "gemini" = Google Gemini 2.0 Flash
# "openai" = OpenAI GPT-4o
# "anthropic" = Anthropic Claude
LLM_PROVIDER=groq

# Groq (https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_key_here
# Groq retires/renames models over time (llama-3.3-70b-versatile, this
# value until it was found 404ing in production, is already gone) --
# check https://console.groq.com/docs/models before deploying.
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# OpenAI (optional)
# OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_MODEL=gpt-4o
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic (optional)
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ----- Embedding Provider -----
# Default architecture is the locally-served multilingual-e5-large-instruct
# model ("e5"). Groq has no embedding API — "gemini" or "openai" also work.
EMBEDDING_PROVIDER=e5

# Expected embedding vector dimension for EMBEDDING_PROVIDER above (e5=1024,
# gemini=3072, openai=1536, local=384). Leave unset to use the provider's
# default; only set this if a non-default model changes the output size.
# EXPECTED_EMBEDDING_DIM=1024

# Web Search Integration (Phase 5)
TAVILY_API_KEY=

# ----- PostgreSQL -----
# Local/self-hosted only: docker compose up -d  (see docker-compose.yml)
# The DataGateway connects directly via async SQLAlchemy + asyncpg — no
# REST/hosted fallback path exists in this repo.
# TLS enabled for Phase 9 deployment hardening:
#
# IMPORTANT (issues.md's 13th Critical finding, migrations/015_app_least_privilege_role.sql):
# this must point at a non-superuser, non-BYPASSRLS role, or every RLS
# policy from Phase 2 is silently inert regardless of correctness — a
# Postgres superuser/BYPASSRLS role always bypasses row-level security,
# no matter what FORCE ROW LEVEL SECURITY or the app's own set_config()
# calls do. Apply migration 015, set a real password for muhafiz_app
# (ALTER ROLE muhafiz_app WITH PASSWORD '...'), then point DATABASE_URL at
# it, same pattern as MCP_DATABASE_URL below. Existing .env files pointing
# at the superuser role will NOT auto-update — this must be changed by
# hand in every real deployment. Verify with scripts/verify_app_role.py.
DATABASE_URL=postgresql+asyncpg://muhafiz_app:CHANGE_ME@localhost:5432/muhafiz?ssl=require

# If DATABASE_URL isn't configured, the app refuses to start rather than
# silently falling back to a legacy SQLite schema that predates the entire
# case/auth/RBAC model. Set to "false" only for narrow legacy/local
# debugging where that degraded mode is genuinely what you want.
REQUIRE_POSTGRES=true

# Least-privilege connection string for the MCP Postgres route (SELECT-only
# on police_reference_data — see migrations/009_mcp_readonly_role.sql).
# No fallback: if unset, the MCP Postgres route raises RuntimeError on
# first use (a startup warning also fires so this is caught before that).
# MCP_DATABASE_URL=postgresql://muhafiz_mcp_readonly:CHANGE_ME@localhost:5432/muhafiz

# Comma-separated list of allowed frontend origins (no spaces around commas).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5174

# ----- Optional local LLM (OpenAI-compatible endpoint) -----
# Reasoning slot (Qwen) — used for routing/rewriting/evaluation/etc.
# Only used when a user's Settings > AI Model Mode is "local".
# Leave LOCAL_LLM_URL empty to disable entirely.
# Updated to use HTTPS for Phase 9:
LOCAL_LLM_URL=https://localhost:8000/v1
LOCAL_LLM_MODEL=qwen3.5-2b
LOCAL_LLM_API_KEY=
LOCAL_LLM_TIMEOUT=20

# Generation slot — used only for the final user-facing answer. Leave
# LOCAL_GEN_LLM_URL empty to disable (falls back to the cloud provider).
LOCAL_GEN_LLM_URL=
LOCAL_GEN_LLM_MODEL=
LOCAL_GEN_LLM_API_KEY=
LOCAL_GEN_LLM_TIMEOUT=20

# Base URL shared by LOCAL_LLM_URL/LOCAL_GEN_LLM_URL/EMBEDDINGS_URL/
# RERANKER_URL when they all live behind one tunnel/model server. Leave
# empty to fall back to LOCAL_LLM_URL.
MODEL_SERVER_BASE_URL=

# Local e5 embeddings + reranker (served via the same model server as
# LOCAL_LLM_URL / LOCAL_GEN_LLM_URL). Only used when EMBEDDING_PROVIDER=e5.
EMBEDDINGS_URL=
RERANKER_URL=

# ----- ChromaDB -----
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=muhafiz_kb

# ----- Muhafiz Data API (docs/decisions/0001-muhafiz-api-migration.md) -----
# A same-schema stand-in for the real police system, serving real-schema
# PSRMS/CMS/PKM/criminal-record data over REST (see API_CONSUMER_GUIDE.md).
# Leave both empty to disable this source entirely — set together, not
# independently (see src/config.py's validate_config()).
MUHAFIZ_API_BASE_URL=
MUHAFIZ_API_KEY=
MUHAFIZ_API_TIMEOUT=60
MUHAFIZ_API_PAGE_SIZE=100

# ----- Pipeline Settings -----
MAX_RETRIES=2
TOP_K_RETRIEVAL=10
TOP_K_RERANK=5
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ----- Guarded web search -----
# Air-gap deployments disable ALL outbound web access (the WEB route and any
# cloud LLM fallback). Requires LOCAL_LLM_URL to be set — with AIR_GAP_MODE
# on and no local endpoint configured, every LLM call fails outright.
AIR_GAP_MODE=false

# Comma-separated allow-list for the WEB route — restricts results to
# government/legal/established-news domains, never the open web.
WEB_ALLOWED_DOMAINS=gov.pk,islamabadpolice.gov.pk,nadra.gov.pk,pakistantoday.com.pk,dawn.com,tribune.com.pk,thenews.com.pk,geo.tv,app.com.pk

# ----- Conversation Memory -----
# Persisted via PostgreSQL (sessions/messages tables), no separate config needed.
MAX_HISTORY_TOKENS=2000

# ----- FastAPI Server -----
HOST=0.0.0.0
PORT=8000
RELOAD=true
# One of: development | staging | production. Gates the cookie Secure flag
# and (per Module 0.2) whether the app refuses to start on a critical
# configuration error. Must be set explicitly and exactly — an unrecognized
# value is treated as a critical startup error.
ENVIRONMENT=development

# ----- Document Ingestion -----
DOCUMENTS_DIR=./data/documents
MAX_UPLOAD_SIZE_MB=50

# ----- Relational Database (legacy SQLite pipeline logging) -----
# Only used in the legacy SQLite fallback (REQUIRE_POSTGRES=false).
DB_PATH=./data/pipeline_logs.db

# ----- Auth -----
# The single most security-critical secret in the app — used to sign/verify
# every JWT. Generate a real random value (e.g. `openssl rand -hex 32`); the
# default below is public (it is in this file) and must never be used
# outside local development.
JWT_SECRET_KEY=your-secret-key-for-dev

